diff -ruN libreboot-baseline/src/mainboard/lenovo/sklkbl_thinkpad/thinkpad25_identity.c candidate-source/src/mainboard/lenovo/sklkbl_thinkpad/thinkpad25_identity.c
--- libreboot-baseline/src/mainboard/lenovo/sklkbl_thinkpad/thinkpad25_identity.c	1970-01-01 00:00:00.000000000 +0000
+++ candidate-source/src/mainboard/lenovo/sklkbl_thinkpad/thinkpad25_identity.c	2026-10-24 02:02:57.073138448 +0000
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Experimental ThinkPad 25: retain identities captured from stock SMBIOS. */
+#include <cbfs.h>
+#include <console/console.h>
+#include <smbios.h>
+#include <string.h>
+
+struct identity {
+	char magic[8];
+	u8 uuid[16];
+	char value[10][128];
+};
+
+static const struct identity *get_identity(void)
+{
+	static struct identity data;
+	static bool attempted;
+	static bool valid;
+	if (!attempted) {
+		attempted = true;
+		valid = cbfs_load("thinkpad25/identity", &data, sizeof(data)) == sizeof(data)
+			&& !memcmp(data.magic, "T25ID001", sizeof(data.magic));
+		for (size_t i = 0; valid && i < ARRAY_SIZE(data.value); i++)
+			valid = memchr(data.value[i], 0, sizeof(data.value[i])) != NULL;
+		if (!valid)
+			printk(BIOS_ERR, "ThinkPad 25 identity missing or invalid\n");
+	}
+	return valid ? &data : NULL;
+}
+
+static const char *identity_string(size_t index)
+{
+	const struct identity *data = get_identity();
+	return data ? data->value[index] : "Unknown";
+}
+
+const char *smbios_system_serial_number(void) { return identity_string(0); }
+const char *smbios_mainboard_serial_number(void) { return identity_string(1); }
+const char *smbios_chassis_serial_number(void) { return identity_string(2); }
+const char *smbios_mainboard_asset_tag(void) { return identity_string(3); }
+const char *smbios_system_sku(void) { return identity_string(4); }
+const char *smbios_system_version(void) { return identity_string(5); }
+const char *smbios_mainboard_version(void) { return identity_string(6); }
+const char *smbios_chassis_version(void) { return identity_string(7); }
+const char *smbios_system_product_name(void) { return identity_string(8); }
+const char *smbios_mainboard_product_name(void) { return identity_string(9); }
+
+void smbios_system_set_uuid(u8 *uuid)
+{
+	const struct identity *data = get_identity();
+	if (data)
+		memcpy(uuid, data->uuid, sizeof(data->uuid));
+}
